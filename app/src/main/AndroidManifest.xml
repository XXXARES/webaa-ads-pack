<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application android:allowBackup="false" android:label="adspack" android:icon="@mipmap/ic_launcher">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-3940256099942544~3347511713" />
        <provider
            android:name="com.webaa.adspack.AdsBoot"
            android:authorities="${applicationId}.webaaadsboot"
            android:exported="false"
            android:initOrder="1" />
        <provider
            android:name="com.webaa.adspack.BillingBoot"
            android:authorities="${applicationId}.webaabillingboot"
            android:exported="false"
            android:initOrder="2" />
        <service android:name="com.webaa.pushpack.PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider
            android:name="com.webaa.pushpack.PushBoot"
            android:authorities="${applicationId}.webaapushboot"
            android:exported="false"
            android:initOrder="3" />
        <provider
            android:name="com.webaa.extpack.ExtBoot"
            android:authorities="${applicationId}.webaaextboot"
            android:exported="false"
            android:initOrder="4" />
        <receiver android:name="com.webaa.extpack.ReminderReceiver" android:exported="false" />
        <receiver android:name="com.webaa.extpack.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name="com.webaa.extpack.BgService" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name="com.webaa.extpack.OpenActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
